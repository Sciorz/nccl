# Faithful translation of astyle options to .clang-format
# Note: A 100% byte-for-byte compatible translation is not possible due to
# differences in the tools' internal logic. This is the closest possible mapping.

Language: Cpp

# Corresponds to: --style=java, --indent=spaces=2
BasedOnStyle: Google
UseTab: Never
IndentWidth: 2
BreakBeforeBraces: Attach

# Corresponds to: --indent-continuation=2
# This is a direct mapping.
ContinuationIndentWidth: 2

# Corresponds to: --indent-switches
# This is a direct mapping.
IndentCaseLabels: true

# Corresponds to: --indent-modifiers
# This is a direct mapping. Offset is relative to the base indent.
AccessModifierOffset: -2

# Corresponds to: --keep-one-line-blocks
# This is a direct mapping.
AllowShortBlocksOnASingleLine: true

# Corresponds to: --keep-one-line-statements
# This requires multiple keys in clang-format for the same behavior.
AllowShortIfStatementsOnASingleLine: true
AllowShortLoopsOnASingleLine: true
AllowShortFunctionsOnASingleLine: All

# Corresponds to: --indent-after-parens
# There is no direct 1:1 mapping for this. This behavior is implicitly
# controlled by the combination of ContinuationIndentWidth and other alignment
# settings. The configuration above provides the most similar result.
AlignAfterOpenBracket: Align
ColumnLimit: 0 # Setting column limit to 0 tries to avoid breaking lines, which helps preserve one-line statements.

# --- The following astyle flags have NO EQUIVALENT inside .clang-format ---
# They are runtime/environmental flags, not style definitions.
#
# -Qv: Runtime verbosity. Not a style option.
# --lineend=linux: Line endings should be managed by your editor or version control system (e.g., .editorconfig, git attributes).
# --suffix=none: This is a command-line flag. The equivalent is running `clang-format -i` to modify files in-place.
